            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "tuner",
            "in": "path",
            "description": "The tuner index, 0 to 7.",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32",
              "maximum": 7,
              "minimum": 0
