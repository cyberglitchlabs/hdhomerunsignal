            "description": "The programs.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Program"
                  }
                }
              }
            }
          },
          "400": {
            "description": "A device, tuner or parameter is not valid.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/devices/{id}/tuner/{tuner}/status": {
      "get": {
        "tags": [
          "tuners"
        ],
        "summary": "Tuner status",
        "operationId": "tuner_status",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "A device ID (e.g. `1080ABCD`), IPv4 address or hostname: letters, digits, dots and hyphens, starting with a letter or digit, at most 253 characters.",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "tuner",
            "in": "path",
            "description": "The tuner index, 0 to 7.",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32",
              "maximum": 7,
              "minimum": 0
            }
          }
        ],
        "responses": {
          "200": {
            "description": "One reading, or null when the tuner did not answer.",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "type": "null"
                    },
                    {
                      "$ref": "#/components/schemas/TunerStatus"
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "description": "A device, tuner or parameter is not valid.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/devices/{id}/tuner/{tuner}/stream": {
      "get": {
        "tags": [
          "streaming"
        ],
        "summary": "Watch a tuner (event stream)",
        "description": "Server-Sent Events: a `tuner-status` event about once a second, whose data is a `TunerEvent`. See the notes on event streams in the API description.",
        "operationId": "tuner_stream",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "A device ID, IPv4 address or hostname.",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "tuner",
            "in": "path",
            "description": "The tuner index, 0 to 7.",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32",
              "maximum": 7,
              "minimum": 0
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The stream; each event is named `tuner-status`.",
            "content": {
              "text/event-stream": {
                "schema": {
                  "$ref": "#/components/schemas/TunerEvent"
                }
              }
            }
          },
          "400": {
            "description": "A device or tuner is not valid.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "429": {
            "description": "This client already holds the most streams it may.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/version": {
      "get": {
        "tags": [
          "app"
        ],
        "summary": "Frontend build version",
        "description": "Read by the page to find out whether a newer build is available.",
        "operationId": "version",
        "responses": {
          "200": {
            "description": "The build.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Version"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AntennaReading": {
        "type": "object",
        "description": "One tuner's reading inside an `antenna-mode-status` event.",
        "required": [
          "tuner"
        ],
        "properties": {
          "status": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/TunerStatus",
                "description": "Null when that tuner did not answer."
              }
            ]
          },
          "tuner": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          }
        }
      },
      "Atsc3Request": {
        "type": "object",
        "description": "The body of `POST .../atsc3`.",
        "required": [
          "channel"
        ],
        "properties": {
          "channel": {
            "type": "string",
            "description": "The RF channel, as digits. A JSON number is accepted too.",
            "example": "27",
            "pattern": "^[0-9]{1,10}$"
          },
          "plps": {
            "type": "array",
            "items": {
              "type": "integer",
              "format": "int32",
              "minimum": 0
            },
            "description": "The PLPs to decode, 0 to 255 each (up to 64). Each may also be a string of digits."
          }
        }
      },
      "ChannelRequest": {
        "type": "object",
        "description": "The body of `POST .../channel`.",
        "required": [
          "channel"
        ],
        "properties": {
          "channel": {
            "type": "string",
            "description": "What to tune: `27`, `auto:27`, `8vsb:27`, `qam256:117`, `auto:575000000`,\n`atsc3:27`, `atsc3:27:0+1+2`, or the special values `none` (stop), `+` and `-`\n(next and previous channel).",
            "example": "auto:27",
            "pattern": "^(?:[a-z0-9]{2,10}:)?[0-9]{1,10}(?::[0-9]{1,3}(?:\\+[0-9]{1,3})*)?$|^(?:none|\\+|-)$"
          }
        }
      },
      "Device": {
        "type": "object",
        "description": "A tuner device the user can pick.",
        "required": [
          "id",
          "ip",
          "name",
          "online"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "What commands address the device by: a device ID, IP address or hostname."
          },
          "ip": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "online": {
            "type": "boolean"
          }
        }
      },
      "DeviceInfo": {
        "type": "object",
        "description": "Model and capabilities of one device.",
        "required": [
          "model",
          "tuners",
          "atsc3Support"
        ],
        "properties": {
          "atsc3Support": {
            "type": "boolean"
          },
          "model": {
            "type": "string"
          },
          "tuners": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          }
        }
      },
      "ErrorBody": {
        "type": "object",
        "description": "The body of every error response.",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "string",
            "description": "What went wrong, in words."
          }
        }
      },
      "PlpInfo": {
        "type": "object",
        "description": "One ATSC 3.0 physical layer pipe, from `/tuner<n>/plpinfo`.",
        "properties": {
          "coderate": {
            "type": [
              "string",
              "null"
            ]
          },
          "layer": {
            "type": [
              "string",
              "null"
            ]
          },
          "lls": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "lock": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "modulation": {
            "type": [
              "string",
              "null"
            ]
          },
          "sfi": {
            "type": [
              "string",
              "null"
            ]
          },
          "timeInterleaving": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "Program": {
        "type": "object",
        "description": "One program (virtual channel) on the tuned channel.",
        "required": [
          "programNum",
          "virtualChannel",
          "name",
          "callsign",
          "status",
          "encrypted",
          "atsc3"
        ],
        "properties": {
          "atsc3": {
            "type": "boolean"
          },
          "callsign": {
            "type": "string",
            "description": "Same as `name`; kept for clients that read it."
          },
          "encrypted": {
            "type": "boolean"
          },
          "name": {
            "type": "string"
          },
          "programNum": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "description": "The parenthesised note after the name, e.g. `encrypted` or `atsc3`."
          },
          "virtualChannel": {
            "type": "string"
          }
        }
      },
      "ScanProgram": {
        "type": "object",
        "description": "A program found during a channel scan.",
        "required": [
          "programNum",
          "virtualChannel",
          "name"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "programNum": {
            "type": "string"
          },
          "virtualChannel": {
            "type": "string"
          }
        }
      },
      "ScannedChannel": {
        "type": "object",
        "description": "A frequency that locked during a channel scan.",
        "required": [
          "frequency",
          "channel",
          "modulation",
          "signalStrength",
          "snr",
          "symbolQuality",
          "programs"
        ],
        "properties": {
          "channel": {
            "type": "string"
          },
          "frequency": {
            "type": "string"
          },
          "modulation": {
            "type": "string"
          },
          "programs": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ScanProgram"
            }
          },
          "signalStrength": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "snr": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "symbolQuality": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          }
        }
      },
      "StreamUrl": {
        "type": "object",
        "description": "A URL a player can open.",
        "required": [
          "url"
        ],
        "properties": {
          "url": {
            "type": "string",
            "example": "http://192.168.1.50:5004/auto/ch34-3"
          }
        }
      },
      "TuneResult": {
        "type": "object",
        "description": "The answer to a tuning command.",
        "required": [
          "success",
          "result"
        ],
        "properties": {
          "result": {
            "type": "string",
            "description": "What the device answered, usually empty."
          },
          "success": {
            "type": "boolean"
          }
        }
      },
      "TunerEvent": {
        "type": "object",
        "description": "The payload of a `tuner-status` event: the tuner's status, plus the current\nprogram and the ATSC 3.0 details.\n\nA tuner that does not answer still produces an event, with none of the status\nfields (no `channel`, no `lock`), so a page can tell the device is not\nreporting. `plpInfo` and `l1Info` are only fetched while a channel is tuned.",
        "required": [
          "currentProgram",
          "plpInfo",
          "l1Info"
        ],
        "properties": {
          "bps": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64",
            "description": "Stream bitrate in bits per second.",
            "minimum": 0
          },
          "channel": {
            "type": [
              "string",
              "null"
            ],
            "description": "The tuned channel as the device reports it, e.g. `auto:34`, or `none`."
          },
          "currentProgram": {
            "type": [
              "string",
              "null"
            ],
            "description": "The selected program number, as the device reports it, or null."
          },
          "debugRaw": {
            "type": [
              "string",
              "null"
            ],
            "description": "The debug counters the dB estimates came from."
          },
          "l1Info": {
            "type": [
              "object",
              "null"
            ],
            "description": "ATSC 3.0 L1 signalling as raw key/value pairs, or null.",
            "additionalProperties": {
              "type": "string"
            },
            "propertyNames": {
              "type": "string"
            }
          },
          "lock": {
            "type": [
              "boolean",
              "null"
            ],
            "description": "Whether the tuner has a lock on the signal."
          },
          "plpInfo": {
            "type": [
              "object",
              "null"
            ],
            "description": "ATSC 3.0 PLPs by id, or null when the device reports none.",
            "additionalProperties": {
              "$ref": "#/components/schemas/PlpInfo"
            },
            "propertyNames": {
              "type": "string"
            }
          },
          "pps": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64",
            "description": "Packets per second.",
            "minimum": 0
          },
          "seq": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64",
            "description": "Symbol error quality, percent.",
            "minimum": 0
          },
          "snq": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64",
            "description": "Signal-to-noise quality, percent.",
            "minimum": 0
          },
          "snrDb": {
            "type": [
              "number",
              "null"
            ],
            "format": "double",
            "description": "Signal-to-noise estimated in dB, when the device reports the counters for it."
          },
          "ss": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64",
            "description": "Signal strength, percent.",
            "minimum": 0
          },
          "ssDb": {
            "type": [
              "number",
              "null"
            ],
            "format": "double",
            "description": "Signal strength estimated in dBm, when the device reports the counters for it."
          }
        }
      },
      "TunerStatus": {
        "type": "object",
        "description": "One reading of `/tuner<n>/status`.",
        "required": [
          "lock"
        ],
        "properties": {
          "bps": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64",
            "description": "Stream bitrate in bits per second.",
            "minimum": 0
          },
          "channel": {
            "type": [
              "string",
              "null"
            ],
            "description": "The tuned channel as the device reports it, e.g. `8vsb:27`, or `none`."
          },
          "debugRaw": {
            "type": [
              "string",
              "null"
            ],
            "description": "The debug counters the dB estimates came from, as `signal-snr/third`."
          },
          "lock": {
            "type": "boolean"
          },
          "pps": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64",
            "description": "Packets per second.",
            "minimum": 0
          },
          "seq": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64",
            "description": "Symbol error quality, percent.",
            "minimum": 0
          },
          "snq": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64",
            "description": "Signal-to-noise quality, percent.",
            "minimum": 0
          },
          "snrDb": {
            "type": [
              "number",
              "null"
            ],
            "format": "double",
            "description": "Signal-to-noise estimated in dB from the debug counters."
          },
          "ss": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64",
            "description": "Signal strength, percent.",
            "minimum": 0
          },
          "ssDb": {
            "type": [
              "number",
              "null"
            ],
            "format": "double",
            "description": "Signal strength estimated in dBm from the debug counters."
          }
        }
      },
      "Version": {
        "type": "object",
        "description": "What the built frontend says about itself.",
        "required": [
          "hash"
        ],
        "properties": {
          "buildTime": {
            "type": [
              "string",
              "null"
            ],
            "description": "When it was built (ISO 8601), or null when unknown."
          },
          "hash": {
            "type": "string",
            "description": "A hash of the build, or `unknown` when there is no build information."
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "devices",
      "description": "Finding devices."
    },
    {
      "name": "tuners",
      "description": "Reading a tuner."
    },
    {
      "name": "tuning",
      "description": "Changing what a tuner is tuned to."
    },
    {
      "name": "streaming",
      "description": "Watching a program and the live event streams."
    },
    {
      "name": "app",
      "description": "The frontend."
    }
  ]
}
